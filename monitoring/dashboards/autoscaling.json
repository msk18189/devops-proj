{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Current vs Desired Replicas (HPA Dynamics)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(up{job=\"fastapi-backend\"} == 1) or vector(2)",
          "legendFormat": "Current Active Replicas",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "kube_hpa_status_desired_replicas{hpa=\"backend-hpa\"} or vector(2)",
          "legendFormat": "HPA Desired Replicas",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter" },
          "unit": "short"
        }
      }
    },
    {
      "title": "Backend CPU Utilization vs 70% HPA Threshold",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(sum(rate(process_cpu_seconds_total[1m])) / (count(up{job=\"fastapi-backend\"} == 1) * 0.25)) * 100",
          "legendFormat": "Average CPU Utilization %",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "vector(70)",
          "legendFormat": "HPA Trigger Target (70%)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "title": "Traffic Load (RPS) vs Pod Scaling Response",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "HTTP Request Rate (RPS)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "API P95 Latency During Scaling Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency (s)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["streamops", "hpa", "autoscaling"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Video Streaming Platform — Autoscaling",
  "uid": "autoscaling-overview"
}
