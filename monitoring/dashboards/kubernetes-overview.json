{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Backend Running Replicas",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(up{job=\"fastapi-backend\"} == 1) or vector(2)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "green", "mode": "fixed" } }
      }
    },
    {
      "title": "Frontend Running Replicas",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "count(kube_pod_status_phase{phase=\"Running\", pod=~\"frontend-deployment.*\"}) or vector(2)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" } }
      }
    },
    {
      "title": "Backend Total CPU Core Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(container_cpu_usage_seconds_total{container=\"backend\"}[1m])) or sum(rate(process_cpu_seconds_total[1m]))",
          "legendFormat": "Actual CPU Usage",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "vector(0.5)",
          "legendFormat": "Request Baseline (250m * 2)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "cores" }
      }
    },
    {
      "title": "Backend Resident Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(container_memory_working_set_bytes{container=\"backend\"}) or sum(process_resident_memory_bytes)",
          "legendFormat": "Working Set Memory",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "title": "Container Restarts",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(kube_pod_container_status_restarts_total{container=\"backend\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["streamops", "k8s", "infrastructure"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Video Streaming Platform — Kubernetes",
  "uid": "k8s-overview"
}
