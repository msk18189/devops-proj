# ============================================================
# Environment Configuration Template
# Video Streaming DevOps Platform
# ============================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
PROJECT_NAME="Video Streaming DevOps Platform"

# Backend & Database (PostgreSQL)
POSTGRES_USER=streaming_user
POSTGRES_PASSWORD=streaming_secure_password_replace_in_prod
POSTGRES_DB=streaming_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://streaming_user:streaming_secure_password_replace_in_prod@postgres:5432/streaming_db

# Security & Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Object Storage (MinIO S3 Compatible)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio_admin_user
MINIO_SECRET_KEY=minio_admin_secure_password
MINIO_BUCKET=videos
MINIO_SECURE=false

# Video Upload Constraints
MAX_VIDEO_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=.mp4,.webm,.mov,.mkv

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="StreamOps"

# Monitoring & Telemetry
PROMETHEUS_METRICS_ENABLED=true
METRICS_PORT=8000
